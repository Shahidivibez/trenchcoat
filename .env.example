# ── Trenchcoat configuration ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. Keys are read from env only.

# Delphi Evidence API (Mainnet). Create at https://api-access.delphi.fyi/
# Sign in the SAME way you sign in to delphi.fyi. Keep "Mainnet" selected.
DELPHI_API_ACCESS_KEY=
# The wallet shown on your Delphi profile (the one you registered on DoraHacks).
DELPHI_WALLET_ADDRESS=

# mock    = full in-process simulation, zero network to Delphi (default; safe)
# dry-run = real READ-ONLY calls (limits/terms/entry-state/markets) when a key
#           is set; submissions & feedback are captured to data/outbox/ instead
#           of sent, and judged locally so the board flow still works.
# live    = real submissions. Requires accepted terms. Spend slots carefully.
DELPHI_MODE=mock
DELPHI_BASE_URL=https://delphi.fyi/v1
DELPHI_MARKETS_URL=https://competition.delphi.fyi/markets.json
DELPHI_FEEDBACK_URL=https://feedback.delphi.fyi/v1/feedback

# Agent identity headers (sent on every call so results show under your name)
DELPHI_AGENT_ID=Trenchcoat
DELPHI_AGENT_HARNESS=trenchcoat
DELPHI_AGENT_MODEL=gemini-2.5-flash

# LLM providers — Gemini free tier primary, pluggable fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Optional search boosters (free tiers). Zero-key DDG + RSS work without them.
SERPER_API_KEY=
TAVILY_API_KEY=

# Behaviour
TRENCHCOAT_AUTOPILOT=0              # 0 = Co-Pilot (human approves each submit)
TRENCHCOAT_DATA_DIR=./data
TRENCHCOAT_MAX_MARKETS_PER_RUN=4
TRENCHCOAT_MAX_SUBMISSIONS_PER_RUN=2
TRENCHCOAT_MIN_SCORE=0.55           # autopilot quality floor
TRENCHCOAT_NOVELTY_SIMHASH=0.86     # similarity >= this blocks as self-duplicate
TRENCHCOAT_MIN_CUTOFF_HOURS=3       # skip markets whose evidence cutoff is sooner
PLAYWRIGHT_ENABLED=1

# Detective Board
BOARD_HOST=127.0.0.1
BOARD_PORT=8000
# Set a token when exposing the board beyond localhost (e.g. HF Spaces).
BOARD_TOKEN=
